module tests.Init.Overloaded;

func main() {
  print("Testing overloaded initializers");
  
  // Test different constructor overloads
  print("Creating point with no parameters:");
  var origin = Point();
  origin.display();
  
  print("Creating point with x coordinate:");
  var pointX = Point(x: 5);
  pointX.display();
  
  print("Creating point with y coordinate:");
  var pointY = Point(y: 3);
  pointY.display();
  
  print("Creating point with both coordinates:");
  var point = Point(x: 10, y: 20);
  point.display();
  
  print("Creating point from another point:");
  var copied = Point(from: point);
  copied.display();
}

public struct Point {
  var x: int;
  var y: int;

  // Default constructor - creates origin
  init() {
    self.x = 0;
    self.y = 0;
  }

  // Constructor with only x coordinate
  init(x _x: int) {
    self.x = _x;
    self.y = 0;
  }

  // Constructor with only y coordinate  
  init(y _y: int) {
    self.x = 0;
    self.y = _y;
  }

  // Constructor with both coordinates
  init(x _x: int, y _y: int) {
    self.x = _x;
    self.y = _y;
  }

  // Copy constructor
  init(from other: Point) {
    self.x = other.x;
    self.y = other.y;
  }

  func display() {
    print("Point coordinates:");
    print(format_int(self.x));
    print(format_int(self.y));
  }
}