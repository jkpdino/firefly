  init(_username: string, _password: string) {
    self.username = _username;
    self.isSecure = true;
    self.securityLevel = "High";
    self.passwordHash = "strong_hash";
    
    // Simple password validation (simplified without method calls)
    // In reality would check length, complexity, etc.
  }

  func isPasswordWeak(_password: string) {
    // Simplified password check
    // In reality would check length, complexity, etc.
    return false; // Placeholder - assume passwords ending in "123" are weak
  }

  func display() {
    print("Secure Account:");
    print(self.username);
    print("Security Level:");
    print(self.securityLevel);
    
    if (self.isSecure) {
      print("Status: Secure");
    } else {
