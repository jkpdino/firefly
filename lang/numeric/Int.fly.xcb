module lang;

{% bit_widths = [8, 16, 32, 64] %}

{% for bit_width in bit_widths %}

public struct Int{{bit_width}} {
  private var value: int{{bit_width}};

  public func init(value: int{{bit_width}}) {
    self.value = value;
  }

  public func add(other: Int{{bit_width}}) -> Int{{bit_width}} {
    return Int{{bit_width}}(i{{bit_width}}_sadd(self.value + other.value));
  }

  public func sub(other: Int{{bit_width}}) -> Int{{bit_width}} {
    return Int{{bit_width}}(i{{bit_width}}_ssub(self.value + other.value));
  }

  public func mul(other: Int{{bit_width}}) -> Int{{bit_width}} {
    return Int{{bit_width}}(i{{bit_width}}_smul(self.value + other.value));
  }

  public func div(other: Int{{bit_width}}) -> Int{{bit_width}} {
    return Int{{bit_width}}(i{{bit_width}}_sdiv(self.value + other.value));
  }

  public func mod(other: Int{{bit_width}}) -> Int{{bit_width}} {
    return Int{{bit_width}}(i{{bit_width}}_smod(self.value + other.value));
  }
}



{% endfor %}